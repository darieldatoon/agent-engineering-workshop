# Copy to .env and fill in. On Binder, the setup cell asks for the keys instead.

# Required. Your own key, for tracing, datasets, and evals: https://smith.langchain.com/settings/apikeys
LANGSMITH_API_KEY=
# Optional. A LangSmith gateway key for model calls, such as the class's shared key.
# Leave it blank and model calls use LANGSMITH_API_KEY.
LANGSMITH_GATEWAY_API_KEY=
LANGSMITH_TRACING=true

# Optional. Set it if your key can reach more than one workspace.
# LANGSMITH_WORKSPACE_ID=

# Optional. Swap models; defaults are LangSmith gateway models. To use your own provider,
# set e.g. KEA_MODEL=openai:gpt-5.4-mini and OPENAI_API_KEY.
# KEA_MODEL=
# KEA_ALT_MODEL=
# KEA_JUDGE_MODEL=

# Optional. false turns off the web-search MCP server in Part 2.
# KEA_ENABLE_MCP=true

# Part 3. The deployed rebooking agent's URL.
# KEA_DEPLOYMENT_URL=
